# .env.example
# ───────────────────────────────────────────────────────
# Helios v0.1 環境變數範本
# 複製為 .env 後填入實際值。.env 不進 git。
# ───────────────────────────────────────────────────────

# Environment
ENV=dev                      # dev | paper | live
MODE=semi_auto               # notification_only | semi_auto | full_auto
LOG_LEVEL=INFO
TIMEZONE=Asia/Taipei

# FinMind (v0.1 必填) - https://finmindtrade.com 註冊取得
FINMIND_TOKEN=

# Telegram (v0.1 Step 8 才需要)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_APPROVAL_TIMEOUT_MIN=30

# Shioaji (v0.4 才需要)
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_SIMULATION=true
